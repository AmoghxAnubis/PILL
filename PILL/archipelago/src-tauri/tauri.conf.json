{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PILL",
  "version": "0.1.0",
  "mainBinaryName": "PILL",
  "identifier": "com.archipelago.island",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "island",
        "title": "",
        "width": 110,
        "height": 32,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "center": false,
        "x": 0,
        "y": 0,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "PILL",
    "category": "Productivity",
    "shortDescription": "A lightweight dynamic island for Windows.",
    "longDescription": "PILL is a Windows desktop overlay that brings media controls, system telemetry, focus sessions, and contextual information into a compact dynamic island.",
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
} 